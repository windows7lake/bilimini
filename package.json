{
  "name": "bilimini",
  "version": "2.0.0",
  "description": "Hide!bilibili",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "win64": "./node_modules/.bin/electron-builder --x64",
    "win32": "./node_modules/.bin/electron-builder --ia32",
    "mac": "npm run mac:build && npm run verify:mac",
    "mac:build": "./node_modules/.bin/electron-builder --mac",
    "verify:mac": "codesign --verify --deep --strict --verbose=4 dist/mac-arm64/bilimini.app",
    "linux": "./node_modules/.bin/electron-builder --linux appimage"
  },
  "repository": "https://github.com/chitosai/bilimini",
  "author": "TheC",
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "mac": {
      "category": "Network",
      "target": [
        "dmg"
      ],
      "identity": "-"
    },
    "linux": {
      "category": "Network",
      "icon": "build/icon256.png"
    }
  },
  "dependencies": {
    "electron-store": "^12.0.0"
  },
  "allowScripts": {
    "electron@44.9.0": true,
    "electron-winstaller@5.4.0": true
  }
}
